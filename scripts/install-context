#!/usr/bin/env python3
"""Install AI Harness context into a product repository."""

from __future__ import annotations

import argparse
import difflib
import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Any


EXIT_OK = 0
EXIT_ERROR = 1
EXIT_DIFFERENT = 2
EXIT_CONFLICT = 3

HARNESS_NAME = "telemedecine-afrique-ai-harness"
PROVENANCE_TEMPLATE = """<!--
GENERATED FILE - DO NOT EDIT MANUALLY

Source: telemedecine-afrique-ai-harness
Profile: {profile}
LLM: {llm}
-->

"""

SENSITIVE_NAMES = {
    ".env",
    "id_rsa",
    "id_ed25519",
}
SENSITIVE_PATTERNS = (
    re.compile(r"^\.env(\..*)?$"),
    re.compile(r".*\.pem$"),
    re.compile(r".*\.key$"),
    re.compile(r".*\.p12$"),
    re.compile(r".*\.pfx$"),
    re.compile(r"credentials?.*", re.IGNORECASE),
    re.compile(r"secrets?.*", re.IGNORECASE),
)


class InstallError(Exception):
    exit_code = EXIT_ERROR


class ConflictError(InstallError):
    exit_code = EXIT_CONFLICT


class DifferentError(InstallError):
    exit_code = EXIT_DIFFERENT


@dataclass(frozen=True)
class PlannedFile:
    destination: str
    source: str
    content: bytes

    @property
    def sha256(self) -> str:
        return sha256_bytes(self.content)


@dataclass
class Analysis:
    creates: list[PlannedFile]
    updates: list[PlannedFile]
    unchanged: list[PlannedFile]
    conflicts: list[tuple[PlannedFile, str]]
    stale: list[str]

    @property
    def has_changes(self) -> bool:
        return bool(self.creates or self.updates)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Install AI Harness context into a product repository."
    )
    parser.add_argument("--llm", required=True, choices=("codex", "claude"))
    parser.add_argument("--profile", required=True)
    parser.add_argument("--target", required=True)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--diff", action="store_true")
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args()

    try:
        return run(args)
    except InstallError as exc:
        print(str(exc), file=sys.stderr)
        return exc.exit_code


def run(args: argparse.Namespace) -> int:
    if args.force and (args.check or args.dry_run or args.diff):
        raise InstallError("--force cannot be combined with --check, --dry-run or --diff")

    harness_root = Path(__file__).resolve().parents[1]
    target = Path(args.target).expanduser().resolve()
    profile_dir = harness_root / "profiles" / args.profile
    adapter_path = harness_root / "llms" / args.llm / "adapter.yaml"

    if not profile_dir.is_dir():
        raise InstallError(f"ERROR: profile not found: {args.profile}")
    if not adapter_path.is_file():
        raise InstallError(f"ERROR: adapter not found for LLM: {args.llm}")
    if not target.is_dir():
        raise InstallError(f"ERROR: target directory not found: {target}")

    profile = read_yaml(profile_dir / "profile.yaml")
    adapter = read_yaml(adapter_path)
    skills_config = read_yaml(profile_dir / "skills.yaml")
    product_docs = read_yaml(profile_dir / "product-doc-pointers.yaml")

    if adapter.get("llm") != args.llm:
        raise InstallError(f"ERROR: adapter LLM mismatch in {rel(adapter_path, harness_root)}")
    if profile.get("profile") != args.profile:
        raise InstallError(f"ERROR: profile name mismatch in {args.profile}")
    if args.llm not in profile.get("adapters", []):
        raise InstallError(f"ERROR: LLM {args.llm} not enabled for profile {args.profile}")

    verify_target(target, product_docs)

    planned = build_plan(
        harness_root=harness_root,
        target=target,
        profile_name=args.profile,
        llm=args.llm,
        adapter=adapter,
        skills_config=skills_config,
    )
    manifest_path = str(adapter["manifest"])
    manifest = build_manifest(args.profile, args.llm, adapter_path, planned, harness_root)
    planned.append(
        PlannedFile(
            destination=manifest_path,
            source="generated:harness-manifest",
            content=json_bytes(manifest),
        )
    )

    previous_manifest = read_manifest(target / manifest_path)
    analysis = analyze_plan(target, planned, previous_manifest)

    print_analysis(analysis)

    if args.diff:
        print_diffs(target, analysis.creates + analysis.updates + [c[0] for c in analysis.conflicts])
        return EXIT_CONFLICT if analysis.conflicts else (EXIT_DIFFERENT if analysis.has_changes else EXIT_OK)

    if args.check:
        if analysis.conflicts:
            print_conflicts(analysis)
            return EXIT_CONFLICT
        if analysis.has_changes or analysis.stale:
            return EXIT_DIFFERENT
        print("Context already up to date.")
        return EXIT_OK

    if args.dry_run:
        if analysis.conflicts:
            print_conflicts(analysis)
            return EXIT_CONFLICT
        if not analysis.has_changes and not analysis.stale:
            print("Context already up to date.")
        return EXIT_OK

    if analysis.conflicts and not args.force:
        print_conflicts(analysis)
        raise ConflictError("Installation aborted because managed files have conflicts.")

    forced_conflicts = bool(args.force and analysis.conflicts)

    if not analysis.has_changes and not analysis.stale and not forced_conflicts:
        print("Context already up to date.")
        return EXIT_OK

    install_files(
        target=target,
        files=analysis.creates + analysis.updates,
        conflicts=analysis.conflicts,
        backup_dir=str(adapter["backup_dir"]),
        force=args.force,
    )
    if analysis.stale:
        for path in analysis.stale:
            print(f"STALE MANAGED FILE: {path}")
    print("Context installed.")
    return EXIT_OK


def read_yaml(path: Path) -> dict[str, Any]:
    text = path.read_text(encoding="utf-8")
    try:
        parsed = StrictYamlParser(text, path).parse()
    except ValueError as exc:
        raise InstallError(str(exc)) from exc
    if not isinstance(parsed, dict):
        raise InstallError(f"ERROR: YAML root must be a mapping: {path}")
    return parsed


class StrictYamlParser:
    """Parse the small YAML subset used by this repository.

    Supported constructs: mappings, nested mappings, lists and simple scalars.
    The parser fails closed for unsupported syntax instead of guessing.
    """

    def __init__(self, text: str, path: Path):
        self.lines = [
            (line_no, raw)
            for line_no, raw in enumerate(text.splitlines(), 1)
            if raw.strip() and not raw.lstrip().startswith("#")
        ]
        self.path = path

    def parse(self) -> Any:
        if not self.lines:
            return {}
        value, index = self._parse_block(0, self._indent(self.lines[0][1]))
        if index != len(self.lines):
            line_no, _ = self.lines[index]
            raise ValueError(f"ERROR: unexpected YAML content at {self.path}:{line_no}")
        return value

    def _parse_block(self, index: int, indent: int) -> tuple[Any, int]:
        if index >= len(self.lines):
            return {}, index
        _, first = self.lines[index]
        if self._indent(first) != indent:
            raise ValueError(f"ERROR: bad indentation at {self.path}:{self.lines[index][0]}")
        if first.lstrip().startswith("- "):
            return self._parse_list(index, indent)
        return self._parse_mapping(index, indent)

    def _parse_mapping(self, index: int, indent: int) -> tuple[dict[str, Any], int]:
        result: dict[str, Any] = {}
        while index < len(self.lines):
            line_no, raw = self.lines[index]
            current_indent = self._indent(raw)
            if current_indent < indent:
                break
            if current_indent > indent:
                raise ValueError(f"ERROR: unexpected indentation at {self.path}:{line_no}")
            stripped = raw.strip()
            if stripped.startswith("- "):
                break
            if ":" not in stripped:
                raise ValueError(f"ERROR: expected key/value at {self.path}:{line_no}")
            key, value = stripped.split(":", 1)
            key = key.strip()
            if not key:
                raise ValueError(f"ERROR: empty key at {self.path}:{line_no}")
            value = value.strip()
            if value:
                result[key] = self._parse_scalar(value)
                index += 1
                continue
            index += 1
            if index >= len(self.lines) or self._indent(self.lines[index][1]) <= indent:
                result[key] = {}
                continue
            result[key], index = self._parse_block(index, self._indent(self.lines[index][1]))
        return result, index

    def _parse_list(self, index: int, indent: int) -> tuple[list[Any], int]:
        result: list[Any] = []
        while index < len(self.lines):
            line_no, raw = self.lines[index]
            current_indent = self._indent(raw)
            if current_indent < indent:
                break
            if current_indent > indent:
                raise ValueError(f"ERROR: unexpected indentation at {self.path}:{line_no}")
            stripped = raw.strip()
            if not stripped.startswith("- "):
                break
            value = stripped[2:].strip()
            if not value:
                raise ValueError(f"ERROR: empty list item at {self.path}:{line_no}")
            if ":" in value and not value.startswith(("'", '"')):
                raise ValueError(f"ERROR: inline mappings are not supported at {self.path}:{line_no}")
            result.append(self._parse_scalar(value))
            index += 1
        return result, index

    @staticmethod
    def _indent(raw: str) -> int:
        if "\t" in raw[: len(raw) - len(raw.lstrip())]:
            raise ValueError("ERROR: tabs are not supported in YAML indentation")
        return len(raw) - len(raw.lstrip(" "))

    @staticmethod
    def _parse_scalar(value: str) -> Any:
        if value in ("true", "false"):
            return value == "true"
        if re.fullmatch(r"-?\d+", value):
            return int(value)
        if (value.startswith('"') and value.endswith('"')) or (
            value.startswith("'") and value.endswith("'")
        ):
            return value[1:-1]
        if any(token in value for token in ("[", "]")):
            raise ValueError(f"ERROR: unsupported YAML scalar syntax: {value}")
        return value


def verify_target(target: Path, product_docs: dict[str, Any]) -> None:
    if not (target / ".git").exists():
        raise InstallError(f"ERROR: target does not look like a Git repository: {target}")
    docs = product_docs.get("product_docs")
    if not isinstance(docs, dict):
        raise InstallError("ERROR: product-doc-pointers.yaml must contain product_docs")
    missing: list[str] = []
    for value in docs.values():
        paths = value if isinstance(value, list) else []
        for item in paths:
            if not isinstance(item, str):
                raise InstallError("ERROR: product document pointer must be a string")
            if not (target / item).is_file():
                missing.append(item)
    if missing:
        formatted = "\n".join(missing)
        raise InstallError(f"ERROR: required product document missing:\n{formatted}")


def build_plan(
    harness_root: Path,
    target: Path,
    profile_name: str,
    llm: str,
    adapter: dict[str, Any],
    skills_config: dict[str, Any],
) -> list[PlannedFile]:
    planned: list[PlannedFile] = []

    entrypoint = require_mapping(adapter, "entrypoint")
    template_source = expand_profile(str(entrypoint["source"]), profile_name)
    destination = str(entrypoint["destination"])
    template_path = source_path(harness_root, template_source)
    ensure_safe_source(template_path, harness_root)
    content = PROVENANCE_TEMPLATE.format(profile=profile_name, llm=llm).encode("utf-8")
    content += template_path.read_bytes()
    planned.append(PlannedFile(destination=destination, source=template_source, content=content))

    context = require_mapping(adapter, "context")
    planned.extend(
        copy_tree_plan(
            harness_root,
            expand_profile(str(context["source"]), profile_name),
            str(context["destination"]),
        )
    )

    skills = adapter.get("skills", {})
    if isinstance(skills, dict) and skills.get("include_profile_recommended"):
        destination_root = str(skills["destination"])
        for skill_path in recommended_skill_paths(skills_config):
            planned.extend(copy_skill_plan(harness_root, skill_path, destination_root))

    agents = adapter.get("agents")
    if isinstance(agents, dict):
        planned.extend(
            copy_tree_plan(
                harness_root,
                expand_profile(str(agents["source"]), profile_name),
                str(agents["destination"]),
            )
        )

    conditional = adapter.get("conditional_skills", {})
    if isinstance(conditional, dict) and conditional.get("include_profile_conditional"):
        destination_root = str(conditional["destination"])
        for skill_path in conditional_skill_paths(skills_config):
            planned.extend(copy_skill_plan(harness_root, skill_path, destination_root))

    assert_unique_destinations(planned)
    for item in planned:
        assert_managed_destination(item.destination, str(adapter["install_root"]))
        if is_sensitive_destination(item.destination):
            raise InstallError(f"ERROR: sensitive destination refused: {item.destination}")
    return sorted(planned, key=lambda item: item.destination)


def require_mapping(data: dict[str, Any], key: str) -> dict[str, Any]:
    value = data.get(key)
    if not isinstance(value, dict):
        raise InstallError(f"ERROR: adapter missing mapping: {key}")
    return value


def expand_profile(value: str, profile_name: str) -> str:
    return value.replace("{profile}", profile_name)


def source_path(harness_root: Path, relative_path: str) -> Path:
    path = (harness_root / relative_path).resolve()
    try:
        path.relative_to(harness_root)
    except ValueError as exc:
        raise InstallError(f"ERROR: source escapes harness root: {relative_path}") from exc
    if not path.exists():
        raise InstallError(f"ERROR: source not found: {relative_path}")
    return path


def copy_tree_plan(harness_root: Path, source: str, destination: str) -> list[PlannedFile]:
    root = source_path(harness_root, source)
    if not root.is_dir():
        raise InstallError(f"ERROR: source must be a directory: {source}")
    planned: list[PlannedFile] = []
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        ensure_safe_source(path, harness_root)
        relative = path.relative_to(root).as_posix()
        planned.append(
            PlannedFile(
                destination=join_posix(destination, relative),
                source=rel(path, harness_root),
                content=path.read_bytes(),
            )
        )
    return planned


def copy_skill_plan(harness_root: Path, skill_path: str, destination_root: str) -> list[PlannedFile]:
    source = source_path(harness_root, skill_path)
    if not source.is_dir():
        raise InstallError(f"ERROR: skill source must be a directory: {skill_path}")
    parts = Path(skill_path).parts
    if len(parts) < 2:
        raise InstallError(f"ERROR: invalid skill path: {skill_path}")
    if parts[0] == "skills":
        destination = join_posix(destination_root, "/".join(parts[1:]))
    else:
        destination = join_posix(destination_root, parts[-1])
    return copy_tree_plan(harness_root, skill_path, destination)


def recommended_skill_paths(skills_config: dict[str, Any]) -> list[str]:
    root = skills_config.get("recommended_skills", {})
    if not isinstance(root, dict):
        return []
    paths: list[str] = []
    for value in root.values():
        if isinstance(value, list):
            paths.extend(str(item) for item in value)
    return paths


def conditional_skill_paths(skills_config: dict[str, Any]) -> list[str]:
    root = skills_config.get("claude_conditional_skills", {})
    if not isinstance(root, dict):
        return []
    paths: list[str] = []
    for value in root.values():
        if isinstance(value, list):
            paths.extend(str(item) for item in value)
    return paths


def ensure_safe_source(path: Path, harness_root: Path) -> None:
    relative = path.relative_to(harness_root)
    for part in relative.parts:
        if part in SENSITIVE_NAMES or any(pattern.fullmatch(part) for pattern in SENSITIVE_PATTERNS):
            raise InstallError(f"ERROR: sensitive source refused: {relative.as_posix()}")


def assert_managed_destination(destination: str, install_root: str) -> None:
    allowed_roots = {install_root, "."}
    first = destination.split("/", 1)[0]
    if destination in ("AGENTS.md", "CLAUDE.md"):
        return
    if first not in {root.split("/", 1)[0] for root in allowed_roots if root != "."}:
        raise InstallError(f"ERROR: destination outside adapter scope: {destination}")
    if ".." in Path(destination).parts or destination.startswith("/"):
        raise InstallError(f"ERROR: unsafe destination: {destination}")


def is_sensitive_destination(destination: str) -> bool:
    return any(
        part in SENSITIVE_NAMES or any(pattern.fullmatch(part) for pattern in SENSITIVE_PATTERNS)
        for part in Path(destination).parts
    )


def assert_unique_destinations(planned: list[PlannedFile]) -> None:
    seen: set[str] = set()
    duplicates: set[str] = set()
    for item in planned:
        if item.destination in seen:
            duplicates.add(item.destination)
        seen.add(item.destination)
    if duplicates:
        raise InstallError("ERROR: duplicate destinations:\n" + "\n".join(sorted(duplicates)))


def build_manifest(
    profile: str,
    llm: str,
    adapter_path: Path,
    files: list[PlannedFile],
    harness_root: Path,
) -> dict[str, Any]:
    return {
        "schema_version": 1,
        "harness": HARNESS_NAME,
        "profile": profile,
        "llm": llm,
        "adapter": rel(adapter_path, harness_root),
        "files": {
            item.destination: {
                "source": item.source,
                "sha256": item.sha256,
            }
            for item in sorted(files, key=lambda current: current.destination)
        },
    }


def read_manifest(path: Path) -> dict[str, Any] | None:
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise ConflictError(f"CONFLICT: existing manifest is invalid JSON: {path}") from exc
    if not isinstance(data, dict) or not isinstance(data.get("files"), dict):
        raise ConflictError(f"CONFLICT: existing manifest has an unsupported format: {path}")
    return data


def analyze_plan(
    target: Path,
    planned: list[PlannedFile],
    previous_manifest: dict[str, Any] | None,
) -> Analysis:
    creates: list[PlannedFile] = []
    updates: list[PlannedFile] = []
    unchanged: list[PlannedFile] = []
    conflicts: list[tuple[PlannedFile, str]] = []
    manifest_files = previous_manifest.get("files", {}) if previous_manifest else {}
    planned_destinations = {item.destination for item in planned}

    for item in planned:
        current_path = target / item.destination
        if not current_path.exists():
            creates.append(item)
            continue
        current = current_path.read_bytes()
        current_hash = sha256_bytes(current)
        if current == item.content:
            unchanged.append(item)
            continue
        if item.source == "generated:harness-manifest":
            updates.append(item)
            continue
        previous = manifest_files.get(item.destination)
        if not isinstance(previous, dict):
            conflicts.append((item, f"CONFLICT: {item.destination} exists and is not managed."))
            continue
        previous_hash = previous.get("sha256")
        if current_hash != previous_hash:
            conflicts.append((item, f"CONFLICT: {item.destination} was modified locally."))
            continue
        updates.append(item)

    stale = [
        path
        for path in sorted(manifest_files)
        if path not in planned_destinations and (target / path).exists()
    ]
    return Analysis(creates, updates, unchanged, conflicts, stale)


def print_analysis(analysis: Analysis) -> None:
    for item in analysis.creates:
        print(f"CREATE {item.destination}")
    for item in analysis.updates:
        print(f"UPDATE {item.destination}")
    for item, message in analysis.conflicts:
        print(message)
    for item in analysis.unchanged:
        print(f"OK {item.destination}")
    for item in analysis.stale:
        print(f"STALE MANAGED FILE: {item}")


def print_conflicts(analysis: Analysis) -> None:
    for _, message in analysis.conflicts:
        print(message, file=sys.stderr)


def print_diffs(target: Path, files: list[PlannedFile]) -> None:
    for item in files:
        current_path = target / item.destination
        current_text = (
            current_path.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)
            if current_path.exists()
            else []
        )
        expected_text = item.content.decode("utf-8", errors="replace").splitlines(keepends=True)
        print(
            "".join(
                difflib.unified_diff(
                    current_text,
                    expected_text,
                    fromfile=f"current/{item.destination}",
                    tofile=f"expected/{item.destination}",
                )
            ),
            end="",
        )


def install_files(
    target: Path,
    files: list[PlannedFile],
    conflicts: list[tuple[PlannedFile, str]],
    backup_dir: str,
    force: bool,
) -> None:
    conflict_destinations = {item.destination for item, _ in conflicts}
    with tempfile.TemporaryDirectory(prefix="install-context-") as tmp:
        tmp_root = Path(tmp)
        for item in files:
            write_temp_file(tmp_root, item)
        for item, _ in conflicts:
            if not force:
                continue
            write_temp_file(tmp_root, item)

        for item in files:
            replace_from_temp(target, tmp_root, item)
        for item, _ in conflicts:
            if not force:
                continue
            if item.destination not in conflict_destinations:
                continue
            backup_existing(target, item.destination, backup_dir)
            replace_from_temp(target, tmp_root, item)


def write_temp_file(tmp_root: Path, item: PlannedFile) -> None:
    path = tmp_root / item.destination
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(item.content)


def replace_from_temp(target: Path, tmp_root: Path, item: PlannedFile) -> None:
    final_path = target / item.destination
    final_path.parent.mkdir(parents=True, exist_ok=True)
    os.replace(tmp_root / item.destination, final_path)


def backup_existing(target: Path, destination: str, backup_dir: str) -> None:
    source = target / destination
    if not source.exists():
        return
    backup_root = target / backup_dir
    backup_root.mkdir(parents=True, exist_ok=True)
    backup_name = destination.replace("/", "__") + ".bak"
    shutil.copy2(source, backup_root / backup_name)
    print(f"BACKUP {destination} -> {join_posix(backup_dir, backup_name)}")


def sha256_bytes(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def json_bytes(data: dict[str, Any]) -> bytes:
    return (json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode("utf-8")


def rel(path: Path, root: Path) -> str:
    return path.resolve().relative_to(root.resolve()).as_posix()


def join_posix(*parts: str) -> str:
    return Path(*parts).as_posix()


if __name__ == "__main__":
    sys.exit(main())
